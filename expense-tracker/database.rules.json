{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        "transactions": {
          "$txId": {
            ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true || (data.child('jointCheckId').exists() && root.child('joint_checks').child(data.child('jointCheckId').val()).child('participants').child(auth.uid).exists()))"
          }
        }
      }
    },
    "user_shares": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "shared_receipts": {
      "$shareCode": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.admin === true || (!data.exists() && newData.child('ownerId').val() === auth.uid && newData.child('shareCode').val() === $shareCode) || (data.exists() && data.child('ownerId').val() === auth.uid))"
      }
    },
    "saved_receipts": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "receipt_savers": {
      "$shareCode": {
        ".read": "auth != null && (auth.token.admin === true || root.child('shared_receipts').child($shareCode).child('ownerId').val() === auth.uid)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('shared_receipts').child($shareCode).child('isActive').val() === true)"
        }
      }
    },
    "temp_codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (((!data.exists() || data.child('userId').val() === auth.uid) && newData.child('userId').val() === auth.uid) || (!newData.exists() && data.child('expiresAt').val() <= now))"
      }
    },
    "user_temp_codes": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "joint_checks": {
      "$jointCheckId": {
        ".read": "auth != null && (auth.token.admin === true || data.child('participants').child(auth.uid).exists())",
        ".write": "auth != null && (auth.token.admin === true || (!data.exists() && newData.child('creatorId').val() === auth.uid && newData.child('participants').child(auth.uid).exists()) || (data.exists() && data.child('participants').child(auth.uid).exists()))"
      }
    },
    "user_families": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        "$familyId": {
          ".write": "auth != null && (auth.token.admin === true || auth.uid === $uid || root.child('families').child($familyId).child('ownerId').val() === auth.uid)"
        }
      }
    },
    "user_family_events": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        "$eventId": {
          ".write": "auth != null && (auth.token.admin === true || (!newData.exists() && auth.uid === $uid) || (!data.exists() && newData.child('familyId').isString() && root.child('families').child(newData.child('familyId').val()).child('members').child(auth.uid).exists() && root.child('families').child(newData.child('familyId').val()).child('members').child($uid).exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['title', 'body', 'familyId', 'createdAt']) && newData.child('title').isString() && newData.child('title').val().length <= 100 && newData.child('body').isString() && newData.child('body').val().length <= 500)"
        }
      }
    },
    "families": {
      "$familyId": {
        ".read": "auth != null && (auth.token.admin === true || data.child('members').child(auth.uid).exists())",
        ".write": "auth != null && (auth.token.admin === true || (!data.exists() && newData.child('ownerId').val() === auth.uid && newData.child('members').child(auth.uid).child('role').val() === 'owner') || (data.exists() && data.child('ownerId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['id', 'name', 'ownerId', 'createdAt', 'members']) && newData.child('id').val() === $familyId && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 40",
        "ownerId": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ((!newData.exists() && data.exists()) || (data.exists() && newData.child('userId').val() === auth.uid && newData.child('role').val() === data.child('role').val() && newData.child('canEditBudget').val() === data.child('canEditBudget').val() && newData.child('canInviteMembers').val() === data.child('canInviteMembers').val()) || (!data.exists() && newData.child('userId').val() === auth.uid && newData.child('role').val() === 'member' && newData.child('canEditBudget').val() === true && newData.child('canInviteMembers').val() === false && newData.child('inviteCode').isString() && root.child('family_invites').child(newData.child('inviteCode').val()).child('familyId').val() === $familyId && root.child('family_invites').child(newData.child('inviteCode').val()).child('isActive').val() === true && root.child('family_invites').child(newData.child('inviteCode').val()).child('expiresAt').val() > now))"
          }
        },
        "iosSnapshot": {
          ".write": "auth != null && (auth.token.admin === true || root.child('families').child($familyId).child('ownerId').val() === auth.uid || (root.child('families').child($familyId).child('members').child(auth.uid).exists() && (!root.child('families').child($familyId).child('members').child(auth.uid).child('canEditBudget').exists() || root.child('families').child($familyId).child('members').child(auth.uid).child('canEditBudget').val() === true)))"
        }
      }
    },
    "family_invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.admin === true || (!data.exists() && newData.child('createdBy').val() === auth.uid && (root.child('families').child(newData.child('familyId').val()).child('ownerId').val() === auth.uid || root.child('families').child(newData.child('familyId').val()).child('members').child(auth.uid).child('canInviteMembers').val() === true)) || (data.exists() && (data.child('createdBy').val() === auth.uid || root.child('families').child(data.child('familyId').val()).child('ownerId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['code', 'familyId', 'familyName', 'createdBy', 'createdAt', 'expiresAt', 'isActive']) && newData.child('code').val() === $code && newData.child('familyId').isString() && newData.child('familyName').isString() && newData.child('expiresAt').isNumber()"
      }
    },
    "vault_payments": {
      ".read": false,
      ".write": false
    },
    "vault_payment_events": {
      ".read": false,
      ".write": false
    },
    "vault_subscriptions": {
      ".read": false,
      ".write": false
    },
    "vault_demo_events": {
      ".read": false,
      ".write": false
    }
  }
}
